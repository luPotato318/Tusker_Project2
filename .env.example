# Desenvolvimento local. Nunca inclua credenciais reais neste arquivo.
DEBUG=True
SECRET_KEY=django-insecure-local-development-only
ALLOWED_HOSTS=localhost,127.0.0.1
PUBLIC_SITE_URL=http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# Em produção: DEBUG=False, chave exclusiva, domínio e HTTPS configurados.
# PostgreSQL/Supabase: use as credenciais somente no ambiente de implantação.
USE_POSTGRES=False
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSLMODE=require
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Tutor: sem chaves, funciona com orientações locais.
LLM_PROVIDER_ORDER=openai,gemini,anthropic
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Imagens: sem chaves, utiliza a ilustração local.
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
REDIS_URL=

# Produção: gere uma chave Fernet exclusiva e guarde-a com segurança.
SAFE_REPORT_ENCRYPTION_KEY=
PHP_BRIDGE_SECRET=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Ative somente em uma implantação com Speed Insights disponível.
SPEED_INSIGHTS_ENABLED=False
SPEED_INSIGHTS_SCRIPT_URL=/_vercel/speed-insights/script.js
SPEED_INSIGHTS_SAMPLE_RATE=1.0
